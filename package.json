{
  "name": "simplysoph-website",
  "version": "0.2.0-beta",
  "packageManager": "npm@10.9.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:links": "vitest run client/src/routing/internal-links.test.ts",
    "test:firestore-rules": "firebase emulators:exec --project demo-simplysoph --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:storage-rules": "firebase emulators:exec --project demo-simplysoph --only storage \"node --test tests/storage.rules.test.mjs\"",
    "test:rules": "npm run test:firestore-rules && npm run test:storage-rules",
    "functions:build": "npm --prefix functions run build",
    "ci:verify": "npm run test:rules && npm run typecheck && npm run test:links && npm run test && npm run functions:build && npm run build",
    "lighthouse": "npx --yes @lhci/cli autorun",
    "lighthouse:collect": "npx --yes @lhci/cli collect",
    "lighthouse:assert": "npx --yes @lhci/cli assert",
    "lighthouse:upload": "npx --yes @lhci/cli upload"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/extension-color": "^3.13.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-text-align": "^3.13.0",
    "@tiptap/extension-text-style": "^3.13.0",
    "@tiptap/extension-youtube": "^3.20.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "algoliasearch": "^4.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.11",
    "firebase": "^11.0.1",
    "framer-motion": "^12.23.22",
    "lucide-react": "^0.453.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^19.1.1",
    "react-helmet": "^6.1.0",
    "react-markdown": "^10.1.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "caniuse-lite": "^1.0.30001799",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.18",
    "firebase-tools": "^15.23.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.4": true,
    "@firebase/util@1.12.1": true
  },
  "overrides": {
    "@hono/node-server": "^2.0.5",
    "esbuild": "^0.28.1",
    "js-yaml": "^4.3.0",
    "tmp": "^0.2.7",
    "uuid": "^14.0.1"
  }
}
