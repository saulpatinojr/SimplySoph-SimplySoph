# =============================================================================
# providers.tf — Provider requirements
# Backend (HCP Terraform Cloud) is declared in backend.tf
# =============================================================================
terraform {
  required_version = ">= 1.5"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_region
}
