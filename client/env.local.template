# ─────────────────────────────────────────────────────────────────────────────
# SimplySoph — Local Development Environment
# Rename this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — it will NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# App
VITE_APP_TITLE=SimplySoph
VITE_APP_LOGO=https://placehold.co/128x128/E1E7EF/1F2937?text=SS

# ── Firebase Client Config ───────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=simplysoph-66c78.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=simplysoph-66c78
VITE_FIREBASE_STORAGE_BUCKET=simplysoph-66c78.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Auth & Roles ─────────────────────────────────────────────────────────────
# UID of the admin/creator account (Sophie's Firebase Auth UID)
# Get from: Firebase Console → Authentication → Users → copy UID
VITE_OWNER_FIREBASE_UID=your-owner-uid

# ── Feature Toggles ──────────────────────────────────────────────────────────
VITE_ENABLE_REALTIME_FEED=true

# ── Firebase Functions Region (AI / Chat) ─────────────────────────────────────
# Region where your Firebase Functions are deployed (default: us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# NOTE: All server credentials (Gemini, Algolia admin, social tokens, email
# token secrets) live SERVER-SIDE in Firebase Functions secrets — never here.
# To set one run: firebase functions:secrets:set GEMINI_API_KEY
