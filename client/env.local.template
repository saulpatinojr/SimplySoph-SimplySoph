# ─────────────────────────────────────────────────────────────────────────────
# SimplySoph — Local Development Environment
# Rename this file to .env.local and fill in your real values.
# .env.local is already in .gitignore — it will NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

# App
VITE_APP_TITLE=SimplySoph
VITE_APP_LOGO=https://placehold.co/128x128/E1E7EF/1F2937?text=SS

# ── Firebase Client Config ───────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=simplysoph-66c78.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=simplysoph-66c78
VITE_FIREBASE_STORAGE_BUCKET=simplysoph-66c78.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Auth & Roles ─────────────────────────────────────────────────────────────
# UID of the admin/creator account (Sophie's Firebase Auth UID)
# Get from: Firebase Console → Authentication → Users → copy UID
VITE_OWNER_FIREBASE_UID=your-owner-uid

# ── Feature Toggles ──────────────────────────────────────────────────────────
VITE_ENABLE_REALTIME_FEED=true

# ── EmailJS (Contact Form) ───────────────────────────────────────────────────
# 1. Sign up free at https://emailjs.com (200 emails/month free)
# 2. Email Services → Add Service (Gmail) → copy Service ID
# 3. Email Templates → Create Template → copy Template ID
#    Template variables used: {{from_name}} {{from_email}} {{subject}} {{message}} {{reply_to}}
# 4. Account → API Keys → copy Public Key
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# ── Firebase Functions Region (AI / Chat) ─────────────────────────────────────
# Region where your Firebase Functions are deployed (default: us-central1)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# NOTE: OpenAI key lives SERVER-SIDE in Firebase Functions secrets — never here.
# To set it run: firebase functions:secrets:set OPENAI_API_KEY
