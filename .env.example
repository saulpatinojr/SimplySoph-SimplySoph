# App Configuration
VITE_APP_TITLE=SimplySoph
VITE_APP_LOGO=https://placehold.co/128x128/E1E7EF/1F2937?text=SS

# Firebase Client Config (replace with values from Firebase console)
VITE_FIREBASE_API_KEY=your-web-api-key
# Set to custom domain (e.g., simplysoph.com) for OAuth consistency
VITE_FIREBASE_AUTH_DOMAIN=simplysoph.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Auth & Roles
VITE_OWNER_FIREBASE_UID=
VITE_ADMIN_EMAIL=sophia@simplysoph.com; administrator@simplysoph.com

# Feature Toggles
VITE_ENABLE_REALTIME_FEED=true

# Algolia Search
VITE_ALGOLIA_APP_ID=your-algolia-app-id
VITE_ALGOLIA_SEARCH_KEY=your-algolia-search-key
VITE_ALGOLIA_INDEX_NAME=dev_content

# ── Social + AI Integration ──────────────────────────────────────────
# TikTok Display API (https://developers.tiktok.com/)
VITE_TIKTOK_CLIENT_KEY=your-tiktok-client-key
# TIKTOK_CLIENT_SECRET goes in Firebase Functions env config only (never expose client-side)

# TikTok – default video to pull comments from on the homepage
VITE_TIKTOK_VIDEO_ID=your-tiktok-video-id

# YouTube Data API v3 (https://console.cloud.google.com/)
VITE_YOUTUBE_API_KEY=your-youtube-data-api-key
# YouTube live video ID — update this whenever Soph goes live
VITE_YOUTUBE_LIVE_VIDEO_ID=
# Site domain — required for YouTube live_chat embed allow-list
VITE_YOUTUBE_SITE_DOMAIN=simplysoph.com

# Gemini API (https://aistudio.google.com/app/apikey)
# Used SERVER-SIDE only in Firebase Functions — never expose in client
# GEMINI_API_KEY=your-gemini-api-key  ← set via: firebase functions:config:set ai.gemini_key="..."
