rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Transitional guard for collections that historically had no status field.
    function isPublishedOrAdmin() {
      return isAdmin()
        || !('status' in resource.data)
        || resource.data.status == 'published';
    }

    // Strict variant for collections where every document always has a
    // status field. Unlike isPublishedOrAdmin(), this has no
    // missing-field fallback, so Firestore can only prove a list query
    // safe when it includes an explicit status == 'published' filter —
    // an unfiltered query is denied rather than silently allowed.
    function isPublishedStrict() {
      return isAdmin() || resource.data.status == 'published';
    }

    function writesRoleAsUser() {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'user';
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && writesRoleAsUser();
      allow update: if isAdmin()
        || (isSelf(uid)
            && writesRoleAsUser()
            && (!('role' in resource.data) || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /photoAlbums/{albumId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Photos carry no status field of their own (visibility follows the
    // parent album), and per-document rules cannot be proven for list
    // queries — isPublishedOrAdmin() would deny every visitor query
    // (fetchPhotosByAlbum / fetchRecentPhotos). Photos are public content.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if isPublishedStrict();
      allow create, update, delete: if isAdmin();
    }

    // Categories are public taxonomy with no status field; a per-document
    // status rule cannot be proven for visitor list queries (fetchCategories).
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /scheduledPosts/{postId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow update, delete: if isAdmin();
    }

    // All subscriber creation goes through the Cloud Function (admin SDK bypasses rules).
    // Direct client writes are denied to enforce double opt-in and rate limiting.
    match /newsletterSubscribers/{subscriberId} {
      allow read, update, delete: if isAdmin();
    }

    // All contact submissions go through the Cloud Function.
    // Direct client writes are denied to enforce rate limiting and App Check.
    match /contact_messages/{docId} {
      allow read, update, delete: if isAdmin();
    }

    // mail collection is written exclusively by Cloud Functions via admin SDK.
    // No client access whatsoever — prevents authenticated users from abusing
    // the Firebase Extension email relay.
    match /mail/{docId} {
      allow read, write: if false;
    }

    // Future feature collections — explicit deny-all for clarity.
    match /wardrobe_items/{doc} {
      allow read, write: if false;
    }

    match /style_personas/{doc} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow get, list, create, update, delete: if false;
    }
  }
}
