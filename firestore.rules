rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidEmail(value) {
      return value is string
        && value.size() <= 320
        && value.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$');
    }

    // Transitional guard for collections that historically had no status field.
    function isPublishedOrAdmin() {
      return isAdmin()
        || !('status' in resource.data)
        || resource.data.status == 'published';
    }

    function writesRoleAsUser() {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'user';
    }

    function validAuthComment() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'postId',
          'postType',
          'content',
          'authorId',
          'authorName',
          'authorPhotoURL',
          'parentId',
          'createdAt',
          'status',
          'updatedAt',
          'replyCount'
        ])
        && d.keys().hasAll(['postId', 'postType', 'content', 'authorId', 'authorName', 'createdAt', 'status'])
        && d.postId is string && d.postId.size() > 0
        && d.postType in ['blog', 'video', 'photo']
        && d.content is string && d.content.size() > 0 && d.content.size() <= 2000
        && d.authorId == request.auth.uid
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 120
        && d.status == 'pending'
        && (d.get('parentId', null) == null || (d.parentId is string && d.parentId.size() > 0));
    }

    function validGuestComment() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'postId',
          'postType',
          'content',
          'authorId',
          'authorName',
          'guestEmail',
          'parentId',
          'createdAt',
          'status',
          'updatedAt',
          'replyCount'
        ])
        && d.keys().hasAll(['postId', 'postType', 'content', 'authorId', 'authorName', 'createdAt', 'status'])
        && d.postId is string && d.postId.size() > 0
        && d.postType in ['blog', 'video', 'photo']
        && d.content is string && d.content.size() > 0 && d.content.size() <= 2000
        && d.authorId is string && d.authorId.matches('^guest_[A-Za-z0-9_-]+$')
        && d.authorName is string && d.authorName.size() > 0 && d.authorName.size() <= 120
        && d.status == 'pending'
        && (d.get('guestEmail', null) == null || isValidEmail(d.guestEmail))
        && (d.get('parentId', null) == null || (d.parentId is string && d.parentId.size() > 0));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && writesRoleAsUser();
      allow update: if isAdmin()
        || (isSelf(uid)
            && writesRoleAsUser()
            && (!('role' in resource.data) || request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /photoAlbums/{albumId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Photos carry no status field of their own (visibility follows the
    // parent album), and per-document rules cannot be proven for list
    // queries — isPublishedOrAdmin() would deny every visitor query
    // (fetchPhotosByAlbum / fetchRecentPhotos). Photos are public content.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /destinations/{destinationId} {
      allow read: if isPublishedOrAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Categories are public taxonomy with no status field; a per-document
    // status rule cannot be proven for visitor list queries (fetchCategories).
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /scheduledPosts/{postId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn() && validAuthComment();
      allow create: if !isSignedIn() && validGuestComment();
      allow update, delete: if isAdmin();
    }

    match /newsletterSubscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'email',
          'subscribedAt',
          'source',
          'active',
          'unsubscribedAt'
        ])
        && request.resource.data.keys().hasAll(['email', 'subscribedAt', 'active'])
        && isValidEmail(request.resource.data.email)
        && request.resource.data.active == true
        && (request.resource.data.get('source', null) == null
          || (request.resource.data.source is string && request.resource.data.source.size() <= 80))
        && request.resource.data.get('unsubscribedAt', null) == null;
      allow update, delete: if isAdmin();
    }

    match /contact_messages/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'email',
          'subject',
          'message',
          'submittedAt',
          'status'
        ])
        && request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'submittedAt', 'status'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && isValidEmail(request.resource.data.email)
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.status == 'unread';
    }

    match /mail/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow get, list, create, update, delete: if false;
    }
  }
}
