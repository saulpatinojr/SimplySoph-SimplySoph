rules_version = '2';

// SimplySoph Firestore Security Rules
// Last updated: March 2, 2026
//
// Authorization model: Firebase Custom Claims
// Admin role is set via the `setAdminClaim` Cloud Function and stored
// in the JWT as `request.auth.token.role == "admin"`.
//
// @see docs/ADMIN_ROLES.md
// @see docs/CODE_REVIEW_REPORT.md \u2014 P1-01, P1-02, CR-1

service cloud.firestore {
  match /databases/{database}/documents {

    // \u2500\u2500 Helper Functions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    /** Check custom claim for admin role (authoritative source) */
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    /** Fallback: also check admin emails for bootstrap scenario */
    function isAdminEmail() {
      return isSignedIn() &&
             request.auth.token.email != null &&
             (request.auth.token.email == 'sophia@simplysoph.com' ||
              request.auth.token.email == 'administrator@simplysoph.com' ||
              request.auth.token.email == 'saulpatinojr@gmail.com');
    }

    /** Combined admin check: custom claim OR known admin email */
    function isAuthorizedAdmin() {
      return isAdmin() || isAdminEmail();
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasRequiredFields(required) {
      return request.resource.data.keys().hasAll(required);
    }

    // \u2500\u2500 Admin Registry (server-managed) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    function writesRoleAsUser() {
      return !('role' in request.resource.data)
        || request.resource.data.role == 'user';
    }

    // Validates guest comment fields so bots can't write arbitrary data
    function isValidGuestComment() {
      let d = request.resource.data;
      return d.keys().hasAll(['body', 'postId', 'status', 'createdAt'])
        && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
        && d.status == 'pending'
        && (d.get('guestName', null) == null || (d.guestName is string && d.guestName.size() <= 80))
        && (d.get('guestEmail', null) == null || (d.guestEmail is string && d.guestEmail.size() <= 200));
    }

    function isValidAuthComment() {
      let d = request.resource.data;
      return d.keys().hasAll(['body', 'postId', 'authorId', 'status', 'createdAt'])
        && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
        && d.authorId == request.auth.uid
        && d.status == 'pending';
    }

    // ── Admin whitelist ─────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read:  if false;
      allow write: if false;
    }

    // \u2500\u2500 User Profiles \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    match /users/{uid} {
      allow read: if isSelf(uid) || isAuthorizedAdmin();

      allow create: if isSelf(uid)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');

      allow update: if isAuthorizedAdmin()
        || (isSelf(uid)
            && request.resource.data.role == resource.data.role);

      allow delete: if isAuthorizedAdmin();
    }

    // \u2500\u2500 Content Collections \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isAuthorizedAdmin();
      allow create, update, delete: if isAuthorizedAdmin();
    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read:   if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && writesRoleAsUser();
      allow update: if isAdmin()
        || (isSelf(uid) && writesRoleAsUser()
            && (!('role' in resource.data) || resource.data.role == 'user'));
      allow delete: if isAdmin();
    }

    // ── Blog posts ──────────────────────────────────────────────────────────
    match /blogPosts/{postId} {
      allow read:                  if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Videos ─────────────────────────────────────────────────────────────
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
      allow read:                  if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Photo albums & photos ──────────────────────────────────────────────────
    match /photoAlbums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    match /scheduledPosts/{postId} {
      allow read: if isAuthorizedAdmin();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // \u2500\u2500 Passport Destinations \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    match /destinations/{destinationId} {
      allow read: if resource.data.status == 'published' || isAuthorizedAdmin();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // \u2500\u2500 Comments \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAuthorizedAdmin();

      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && hasRequiredFields(['content', 'authorId', 'createdAt']);

      allow update: if isAuthorizedAdmin();

      allow delete: if isAuthorizedAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // \u2500\u2500 Newsletter Subscribers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    match /newsletterSubscribers/{subscriberId} {
      allow read: if isAuthorizedAdmin();
      // FIX: service writes `subscribedAt` not `createdAt` — require the correct field name.
      allow create: if hasRequiredFields(['email', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.matches('.*@.*\..*');
      allow update: if isAuthorizedAdmin();
      allow delete: if isAuthorizedAdmin();
    }

    // \u2500\u2500 Contact Form Submissions \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500

    match /contactSubmissions/{submissionId} {
      allow read: if isAuthorizedAdmin();
      allow create: if hasRequiredFields(['name', 'email', 'message']);
      allow update, delete: if isAuthorizedAdmin();
    }
    // contact_messages is the actual collection name used by the client
    match /contact_messages/{docId} {
      allow read, update, delete: if isAuthorizedAdmin();
      allow create: if hasRequiredFields(['name', 'email', 'message']);
    }

    // mail collection -- written by client to trigger Firebase Extension email delivery
    // The extension reads/deletes via Admin SDK, so only allow create from signed-in users
    match /mail/{docId} {
      allow create: if isSignedIn();
      allow read, update, delete: if false;
    }


    // \u2500\u2500 Catch-all deny \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
      allow read:                  if true;
      allow create, update, delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read:                  if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Comments ─────────────────────────────────────────────────────────────
    // Authenticated users → their own authorId-keyed comments
    // Unauthenticated guests → allowed to post with guestName/guestEmail
    // Both paths require body to be non-empty and status set to 'pending'
    match /comments/{commentId} {
      // Public can read approved comments; admins see everything
      allow read: if resource.data.status == 'approved' || isAdmin();

      // Authenticated create: must pass authorId validation
      allow create: if isSignedIn() && isValidAuthComment();

      // Guest create: unauthenticated, validated fields only
      allow create: if !isSignedIn() && isValidGuestComment();

      // Admin can moderate (approve, flag, delete)
      allow update: if isAdmin();
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // ── Newsletter subscribers ─────────────────────────────────────────────────
    match /newsletterSubscribers/{subscriberId} {
      allow read:   if isAdmin();
      allow create: if true;  // Anyone can subscribe — no auth required
      allow update: if true;  // Allows unsubscribe via email token link
      allow delete: if isAdmin();
    }

    // ── Categories ────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read:                  if true;
      allow create, update, delete: if isAdmin();
    }

    // ── Scheduled posts (Content Calendar) ─────────────────────────────────────
    match /scheduledPosts/{postId} {
      allow read:                  if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Analytics events ─────────────────────────────────────────────────────
    match /analyticsEvents/{eventId} {
      allow read:   if isAdmin();
      allow create: if true;  // Any visitor can write an analytics event
      allow update, delete: if isAdmin();
    }

    // ── Catch-all: deny everything else ───────────────────────────────────────
    match /{document=**} {
      allow get, list:             if false;
      allow create, update, delete: if false;
    }
  }
}
