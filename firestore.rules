rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function writesRoleAsUser() {
      return !('role' in request.resource.data) || request.resource.data.role == 'user';
    }

    match /admins/{uid} {
      allow read: if false;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && writesRoleAsUser();
      allow update: if isAdmin() || (isSelf(uid) && writesRoleAsUser() && (!('role' in resource.data) || resource.data.role == 'user'));
      allow delete: if isAdmin();
    }

    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /photoAlbums/{albumId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // Newsletter subscribers
    match /newsletterSubscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if true; // Anyone can subscribe
      allow update: if true; // Allow unsubscribe via email link
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow get, list: if false;
      allow create, update, delete: if false;
    }
  }
}
