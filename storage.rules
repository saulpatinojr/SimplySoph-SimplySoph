rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin check via Firebase custom claim (set with the setAdminClaim
    // Cloud Function; the first claim is bootstrapped out-of-band with the
    // Admin SDK — see docs/ADMIN_ROLES.md).
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isValidImage() {
      // Allow image/* and application/octet-stream (some browsers send webp as octet-stream)
      return request.resource.size < 15 * 1024 * 1024 // 15MB to accommodate multi-size webp processing
             && (request.resource.contentType.matches('image/.*')
                 || request.resource.contentType == 'application/octet-stream');
    }

    function isValidVideo() {
      return request.resource.size < 100 * 1024 * 1024 // 100MB
             && (request.resource.contentType.matches('video/.*')
                 || request.resource.contentType == 'application/octet-stream');
    }

    // Blog post cover images
    match /blog-covers/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Blog post content images
    match /blog-content/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Video files
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin() && isValidVideo();
      allow delete: if isAdmin();
    }

    // Video thumbnails
    match /video-thumbnails/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Photo albums - allow all sub-paths (thumbnail, medium, large, original variants)
    match /photos/{allFiles=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Album covers
    match /album-covers/{imageId} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // User avatars
    match /avatars/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidImage();
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Passport Destinations
    match /destinations/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

